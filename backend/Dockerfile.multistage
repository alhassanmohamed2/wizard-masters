# Build Stage
FROM clojure:lein AS builder

WORKDIR /app
COPY project.clj .
# Resolve dependencies first for caching
RUN lein deps

COPY . .
# Build Uberjar
RUN lein uberjar

# Run Stage
FROM eclipse-temurin:17-jre-alpine

WORKDIR /app
RUN apk update && apk add htop procps

# Create necessary directories
RUN mkdir -p /resources/keys
# Copy Keys (Assuming they exist in source)
COPY resources/keys/firestore.json /resources/keys/firestore.json

# Copy built jar from builder stage
# Note: Path depends on project.clj target-path defaulting to target/uberjar or similar
# We use find/wildcard or explicit path. project.clj says: "target/%s/" and uberjar-name "enion-backend.jar"
# So it should be target/uberjar/enion-backend.jar
COPY --from=builder /app/target/uberjar/enion-backend.jar /app.jar

EXPOSE 8080

ENTRYPOINT exec java -server \
                     -Xmx1500m \
                     -jar \
                     /app.jar
